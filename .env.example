# ---------------------------------------------------------------------------
# AM Global Commodities — environment configuration
#
# Copy to `.env.local` for development. `.env*` is git-ignored: never commit
# real values, and never prefix a secret with NEXT_PUBLIC_ (that would ship it
# to the browser).
# ---------------------------------------------------------------------------

# Destination for trade enquiries. Server-side only.
TRADE_ENQUIRY_TO=antoniomarcoindia@gmail.com

# From-address the enquiry notification is sent as. Must be an address the
# transactional email provider has verified for the sending domain.
TRADE_ENQUIRY_FROM=

# API key for the transactional email provider. Leave blank in development —
# enquiries are logged rather than sent when this is unset.
TRADE_ENQUIRY_API_KEY=

# Canonical site origin. Only needed to override the production default
# (https://amglobalcommodities.com), e.g. on a preview deployment.
NEXT_PUBLIC_SITE_URL=

# Optional. Overrides the provider endpoint — used for local testing, or to
# target a regional endpoint. Defaults to https://api.resend.com/emails
TRADE_ENQUIRY_API_URL=
